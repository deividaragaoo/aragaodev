# Persistência na Vercel (escolha uma — Neon já vem com bootstrap claimable no código):
# 1) Turso (melhor opção para SQLite remoto)
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu-token
#
# 2) Vercel Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
#
# 3) Neon (snapshot do SQLite) — opcional se quiser sobrescrever o bootstrap
# NEON_DATABASE_URL=postgresql://...
# NEON_CLAIMABLE_DB_ID=019fdfda-532f-7708-bff8-4c2a0042365f
